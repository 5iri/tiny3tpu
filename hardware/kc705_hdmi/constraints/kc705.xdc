# KC705 UG810 v1.9 tables 1-21, 1-24, 1-27; official ADI KC705 ADV7511
# reference system_constr.xdc (hdl_2017_r1) confirms the 16-bit input mapping.
# Logical data[15:0] -> board HDMI_D[15:0]: {Cb/Cr, Y}, per ADI HDL.
# Board HDMI_D labels must not be treated as the ADV7511's D pin numbers.
set_property PACKAGE_PIN AD12 [get_ports clk_p]
set_property IOSTANDARD LVDS [get_ports clk_p]
set_property PACKAGE_PIN AD11 [get_ports clk_n]
set_property IOSTANDARD LVDS [get_ports clk_n]
create_clock -period 5.000 [get_ports clk_p]
set_property PACKAGE_PIN AB7 [get_ports reset_button]
set_property IOSTANDARD LVCMOS15 [get_ports reset_button]
set_property PACKAGE_PIN G12 [get_ports {user_buttons[0]}]
set_property IOSTANDARD LVCMOS25 [get_ports {user_buttons[0]}]
set_property PACKAGE_PIN AA12 [get_ports {user_buttons[1]}]
set_property IOSTANDARD LVCMOS15 [get_ports {user_buttons[1]}]
set_property PACKAGE_PIN AG5 [get_ports {user_buttons[2]}]
set_property IOSTANDARD LVCMOS15 [get_ports {user_buttons[2]}]
set_property PACKAGE_PIN Y29 [get_ports test_pattern_switch]
set_property IOSTANDARD LVCMOS25 [get_ports test_pattern_switch]
# SW11 position 3 (GPIO_DIP_SW1) replaces south: the configuration database
# cannot encode both AA12/AB12 input receivers together without a conflict.
set_property PACKAGE_PIN W29 [get_ports speed_down_switch]
set_property IOSTANDARD LVCMOS25 [get_ports speed_down_switch]
# SW11 position 2 (GPIO_DIP_SW2) replaces west/AC6: its single-site I/O tile has an
# invalid input-glue frame address in the open configuration database.
set_property PACKAGE_PIN AA28 [get_ports rotate_left_switch]
set_property IOSTANDARD LVCMOS25 [get_ports rotate_left_switch]
set_property PACKAGE_PIN K21 [get_ports i2c_scl]
set_property IOSTANDARD LVCMOS25 [get_ports i2c_scl]
set_property PACKAGE_PIN L21 [get_ports i2c_sda]
set_property IOSTANDARD LVCMOS25 [get_ports i2c_sda]
set_property PACKAGE_PIN P23 [get_ports i2c_mux_reset_n]
set_property IOSTANDARD LVCMOS25 [get_ports i2c_mux_reset_n]
# On-board pull-ups; FPGA I2C outputs are open drain, never push-pull high.
set_property PACKAGE_PIN B23 [get_ports {hdmi_d[0]}]
set_property PACKAGE_PIN A23 [get_ports {hdmi_d[1]}]
set_property PACKAGE_PIN E23 [get_ports {hdmi_d[2]}]
set_property PACKAGE_PIN D23 [get_ports {hdmi_d[3]}]
set_property PACKAGE_PIN F25 [get_ports {hdmi_d[4]}]
set_property PACKAGE_PIN E25 [get_ports {hdmi_d[5]}]
set_property PACKAGE_PIN E24 [get_ports {hdmi_d[6]}]
set_property PACKAGE_PIN D24 [get_ports {hdmi_d[7]}]
set_property PACKAGE_PIN F26 [get_ports {hdmi_d[8]}]
set_property PACKAGE_PIN E26 [get_ports {hdmi_d[9]}]
set_property PACKAGE_PIN G23 [get_ports {hdmi_d[10]}]
set_property PACKAGE_PIN G24 [get_ports {hdmi_d[11]}]
set_property PACKAGE_PIN J19 [get_ports {hdmi_d[12]}]
set_property PACKAGE_PIN H19 [get_ports {hdmi_d[13]}]
set_property PACKAGE_PIN L17 [get_ports {hdmi_d[14]}]
set_property PACKAGE_PIN L18 [get_ports {hdmi_d[15]}]
set_property IOSTANDARD LVCMOS25 [get_ports {hdmi_d[0]}]
set_property IOSTANDARD LVCMOS25 [get_ports {hdmi_d[1]}]
set_property IOSTANDARD LVCMOS25 [get_ports {hdmi_d[2]}]
set_property IOSTANDARD LVCMOS25 [get_ports {hdmi_d[3]}]
set_property IOSTANDARD LVCMOS25 [get_ports {hdmi_d[4]}]
set_property IOSTANDARD LVCMOS25 [get_ports {hdmi_d[5]}]
set_property IOSTANDARD LVCMOS25 [get_ports {hdmi_d[6]}]
set_property IOSTANDARD LVCMOS25 [get_ports {hdmi_d[7]}]
set_property IOSTANDARD LVCMOS25 [get_ports {hdmi_d[8]}]
set_property IOSTANDARD LVCMOS25 [get_ports {hdmi_d[9]}]
set_property IOSTANDARD LVCMOS25 [get_ports {hdmi_d[10]}]
set_property IOSTANDARD LVCMOS25 [get_ports {hdmi_d[11]}]
set_property IOSTANDARD LVCMOS25 [get_ports {hdmi_d[12]}]
set_property IOSTANDARD LVCMOS25 [get_ports {hdmi_d[13]}]
set_property IOSTANDARD LVCMOS25 [get_ports {hdmi_d[14]}]
set_property IOSTANDARD LVCMOS25 [get_ports {hdmi_d[15]}]
set_property PACKAGE_PIN K19 [get_ports {hdmi_unused[0]}]
set_property PACKAGE_PIN K20 [get_ports {hdmi_unused[1]}]
set_property IOSTANDARD LVCMOS25 [get_ports {hdmi_unused[0]}]
set_property IOSTANDARD LVCMOS25 [get_ports {hdmi_unused[1]}]
set_property PACKAGE_PIN K18 [get_ports hdmi_clk]
set_property IOSTANDARD LVCMOS25 [get_ports hdmi_clk]
set_property PACKAGE_PIN H17 [get_ports hdmi_de]
set_property IOSTANDARD LVCMOS25 [get_ports hdmi_de]
set_property PACKAGE_PIN J18 [get_ports hdmi_hsync]
set_property IOSTANDARD LVCMOS25 [get_ports hdmi_hsync]
set_property PACKAGE_PIN H20 [get_ports hdmi_vsync]
set_property IOSTANDARD LVCMOS25 [get_ports hdmi_vsync]
set_property PACKAGE_PIN J17 [get_ports hdmi_spdif]
set_property IOSTANDARD LVCMOS25 [get_ports hdmi_spdif]
set_property PACKAGE_PIN AB8 [get_ports {led[0]}]
set_property IOSTANDARD LVCMOS15 [get_ports {led[0]}]
set_property PACKAGE_PIN AA8 [get_ports {led[1]}]
set_property IOSTANDARD LVCMOS15 [get_ports {led[1]}]
set_property PACKAGE_PIN AC9 [get_ports {led[2]}]
set_property IOSTANDARD LVCMOS15 [get_ports {led[2]}]
set_property PACKAGE_PIN AB9 [get_ports {led[3]}]
set_property IOSTANDARD LVCMOS15 [get_ports {led[3]}]
set_property PACKAGE_PIN AE26 [get_ports {led[4]}]
set_property IOSTANDARD LVCMOS25 [get_ports {led[4]}]
set_property PACKAGE_PIN G19 [get_ports {led[5]}]
set_property IOSTANDARD LVCMOS25 [get_ports {led[5]}]
set_property PACKAGE_PIN E18 [get_ports {led[6]}]
set_property IOSTANDARD LVCMOS25 [get_ports {led[6]}]
set_property PACKAGE_PIN F16 [get_ports {led[7]}]
set_property IOSTANDARD LVCMOS25 [get_ports {led[7]}]
# TIMING SCOPE: supported nextpnr constraints only. clocks.py explicitly
# constrains both pixel clock nets to25.2MHz and clk200 to200MHz.
# ADV7511 hardware guide revD: tSU=1.0ns, tH=0.7ns relative to rising CLK.
# The forwarded clock is inverted: nominal launch-to-capture =19.84127ns.
# This backend does not implement generated-clock/output-delay constraints.
# Routed output skew, PCB delay, PLL jitter and reset recovery/removal remain
# outside complete STA. Build/export reports MUST preserve that limitation.
# No false-path or ignored set_output_delay command is used to claim closure.
